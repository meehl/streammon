# Optional shared defaults. Uncomment and adjust as needed. Always use absolute paths.
#
# Per-channel env files override these.
# If set, channels without OUTPUT_DIR record to $RECORDINGS_ROOT/<channel>.
# RECORDINGS_ROOT=/home/user/recordings
#
# streamlink is looked up on PATH, then in ~/.local/bin. Set this to use a
# specific executable.
# STREAMLINK=/home/user/.local/bin/streamlink
