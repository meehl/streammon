# Copy to channels/<channel>.env.
STREAM_URL=https://www.twitch.tv/test
# Optional. If unset, defaults to $RECORDINGS_ROOT/<channel> when
# RECORDINGS_ROOT is set in defaults.env.
OUTPUT_DIR=/home/user/recordings/test
# Filename template without extension; .ts is always appended.
OUTPUT_TEMPLATE=test__{time}__{id}
