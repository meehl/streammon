#!/usr/bin/env bash

set -u
shopt -s nullglob

msg() {
  printf '%s\n' "${1-}" >&2
}

die() {
  local message="${1}"
  local code="${2:-1}"

  msg "${message}"
  exit "${code}"
}

CHANNEL="${1:?usage: streammon <channel-id>}"

SUCCESS_DELAY=2
STOP_RC=78 # Used to prevent systemd from restarting

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/streammon"
channels_dir="$config_dir/channels"
global_conf="$config_dir/streamlink.conf"
channel_conf="$channels_dir/${CHANNEL}.conf"
sl_args=(--config "$global_conf" --config "$channel_conf")

[[ -z ${STREAM_URL:-} ]] && die "STREAM_URL is not configured" "$STOP_RC"
[[ -z ${STREAM_QUALITY:-} ]] && STREAM_QUALITY=best
[[ -z ${OUTPUT_TEMPLATE:-} ]] && OUTPUT_TEMPLATE="{time}"

# A per-channel OUTPUT_DIR takes precedence over RECORDINGS_ROOT.
if [[ -z ${OUTPUT_DIR:-} ]]; then
    [[ -n ${RECORDINGS_ROOT:-} ]] ||
        die "OUTPUT_DIR is not configured and RECORDINGS_ROOT is unset" "$STOP_RC"
    OUTPUT_DIR="${RECORDINGS_ROOT%/}/${CHANNEL}"
fi

# Check prerequisites.
# Both config files are optional but have to be readable if they exist.
for conf in "$global_conf" "$channel_conf"; do
    [[ ! -e "$conf" || ( -f "$conf" && -r "$conf" ) ]] ||
        die "ERROR: Cannot read streamlink configuration: $conf" "$STOP_RC"
done
command -v streamlink >/dev/null 2>&1 || die "ERROR: Streamlink executable not found" "$STOP_RC"

# Pre-validate configuration and exit early if invalid
streamlink "${sl_args[@]}" --can-handle-url-no-redirect "$STREAM_URL" ||
    die "ERROR: Streamlink pre-validation failed" "$STOP_RC"

# Create output directory
mkdir -p "${OUTPUT_DIR}" ||
    die "ERROR: Cannot create output directory: ${OUTPUT_DIR}" $STOP_RC

# Start monitoring
while true; do
    # We don't know the output file name in advance if metadata variables are used.
    # Create a temporary directory so it can be found more easily.
    tmp_dir="$(mktemp -d "${OUTPUT_DIR}/.streammon.XXXXXX")" ||
        die "ERROR: Could not create temporary recording directory."
    output="${tmp_dir}/${OUTPUT_TEMPLATE}.ts"

    msg "Starting streamlink for ${CHANNEL}..."
    streamlink "${sl_args[@]}" --output "$output" "$STREAM_URL" "$STREAM_QUALITY"
    RC=$?

    # Move recording into final output directory
    recordings=("${tmp_dir}"/*.ts)
    ((${#recordings[@]})) && mv -- "${recordings[0]}" "${OUTPUT_DIR}/"
    rmdir -- "${tmp_dir}" 2>/dev/null ||
        msg "WARNING: Temporary files remain in ${tmp_dir}"

    case "$RC" in
        0)
            msg "Recording finished. Restarting in ${SUCCESS_DELAY}s."
            sleep "$SUCCESS_DELAY"
            ;;
        2)
            die "ERROR: Streamlink argument error. Stopping." $STOP_RC
            ;;
        *)
            die "Streamlink exited with status ${RC}." $RC
            ;;
    esac
done
