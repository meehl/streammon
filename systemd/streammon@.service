[Unit]
Description=Streamlink recorder for %i

[Service]
Type=simple
# defaults.env is optional. channel env files override it.
EnvironmentFile=-%h/.config/streammon/defaults.env
EnvironmentFile=%h/.config/streammon/channels/%i.env
# Newer systemd versions can use:
# ExecStart=%h/.local/libexec/streammon/recorder %i
# A shell wrapper is used for better compatibility with older versions
# that don't allow specifiers in the first argument.
ExecStart=/bin/sh -c 'exec "$HOME/.local/libexec/streammon/recorder" %i'
Restart=on-failure
RestartSec=20s
RestartPreventExitStatus=78
KillSignal=SIGINT
TimeoutStopSec=30s

[Install]
WantedBy=default.target
